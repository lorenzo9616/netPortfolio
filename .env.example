# Copy this file to .env before running docker-compose.
# The defaults below work out-of-the-box for local demo/testing.
# Change POSTGRES_PASSWORD and BACKEND_API_KEY before any public deployment.

POSTGRES_DB=ocrdb
POSTGRES_USER=ocruser
POSTGRES_PASSWORD=changeme

# Leave blank to disable API key auth (fine for local dev/demo)
BACKEND_API_KEY=

# Anthropic API key for AI document classification (required for document type detection)
ANTHROPIC_API_KEY=

# URL the browser uses to reach the backend REST API
NEXT_PUBLIC_API_URL=http://localhost:5000
