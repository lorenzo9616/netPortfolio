{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "ConnectionStrings": {
    // Use localhost when running outside Docker (docker-compose overrides this via env var for containers)
    "DefaultConnection": "Host=localhost;Port=5432;Database=ocrdb;Username=ocruser;Password=changeme"
  },
  "Auth": {
    // Empty = API key auth disabled in development (middleware skips check)
    "ApiKey": ""
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Services": {
    // Override to point at the locally-running Python OCR engine during development
    "OcrServiceUrl": "http://localhost:8000"
  }
}
